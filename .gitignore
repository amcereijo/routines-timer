logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# Build output
dist/

# OS files
.DS_Store

# Zepp OS tooling cache
.zepp/

# Local env files (secrets and machine-specific values).
# The .env.example templates stay tracked so a fresh clone knows which
# variables to create and where to get them.
zepp_app/.env*
!zepp_app/.env.example
web/.env*
!web/.env.example
