# Web app configuration template.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored — never commit the filled-in copy. In
# production, set the same variables in Vercel under
# Project Settings → Environment Variables.
#
# Everything below is required unless marked otherwise.

# --- Database -------------------------------------------------------------

# libSQL / Turso connection URL.
#   Local development : file:./dev.db        (plain SQLite file, no token)
#   Production        : libsql://<db>-<org>.turso.io
# The schema (routines, codes, shares, rate_hits) is created automatically on
# the first request, so an empty database is fine.
TURSO_DATABASE_URL=file:./dev.db

# Auth token for a remote Turso database.
# Leave empty when TURSO_DATABASE_URL points at a local file.
# Create one in the Turso dashboard → your database → Auth Tokens.
TURSO_AUTH_TOKEN=

# --- Authentication --------------------------------------------------------

# Accounts allowed to sign in, as a JSON array. Every account has a username
# and a password; `name` is optional (shown in the UI) and `admin` gives the
# account access to every routine.
#
#   AUTH_USERS=[{"username":"angel","password":"change-me","name":"Angel","admin":true},
#               {"username":"sam","password":"change-me-too","name":"Sam"}]
#
# The object form works as well:
#
#   AUTH_USERS={"angel":{"password":"change-me","admin":true},"sam":"change-me-too"}
#
# Passwords are stored in plain text in this variable, exactly like the
# password below — treat it as a secret and rotate it like SESSION_SECRET.
AUTH_USERS=

# Legacy single-operator password. Only used when AUTH_USERS is not set (or
# holds no usable account); the operator then signs in as "admin" with this
# password. Remove it once AUTH_USERS is configured.
ADMIN_PASSWORD=

# HMAC secret used to sign session cookies (12 h expiry).
# Generate one with: openssl rand -hex 32
# Rotating it invalidates every session that was already issued.
SESSION_SECRET=
