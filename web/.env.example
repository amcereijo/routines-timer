# Copy to .env.local for local development; set these in Vercel for production.

# Turso database (remote: libsql://<db>-<org>.turso.io + auth token;
# local dev may use a plain SQLite file: file:./dev.db with no token)
TURSO_DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# Single-operator login password
ADMIN_PASSWORD=

# HMAC secret for signing session cookies (rotate to invalidate sessions)
SESSION_SECRET=
