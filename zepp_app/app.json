{
  "configVersion": "v3",
  "app": {
    "appId": 1132936,
    "appName": "Routines Timer",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "angel",
    "description": "Create, save and run sequences of timers with pause/stop control."
  },
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.7",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "balance": {
      "module": {
        "page": {
          "pages": [
            "page/home",
            "page/create",
            "page/saved",
            "page/run",
            "page/import"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Routines Timer"
    }
  },
  "permissions": ["device:os.local_storage"],
  "defaultLanguage": "en-US",
  "debug": false
}
