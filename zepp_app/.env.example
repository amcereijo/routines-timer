# Build-time configuration for the watch app.
# Copy to .env (or export the variables in your shell) before `npm run build`.
# .env is read by scripts/write-config.js and by zeus itself.

# Base URL of the deployed web app that serves /api/routines/resolve.
# Injected into the packaged app-side service at build time.
RESOLVE_BASE_URL=https://web-amcereijos-projects.vercel.app
